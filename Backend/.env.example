# ================================
# Configuración del Servidor
# ================================
# Puerto en el que se ejecutará el servidor Express
PORT=3900

# ================================
# Base de Datos MongoDB
# ================================
# URI de conexión a MongoDB
# Formato: mongodb://<host>:<puerto>/<nombre_base_datos>
# Para Docker local: mongodb://localhost:27017/api_rest_blog
# Para MongoDB Atlas: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<nombre_base_datos>
MONGODB_URI=mongodb://localhost:27017/api_rest_blog

# ================================
# Configuración de CORS
# ================================
# Orígenes permitidos (separados por coma si son múltiples)
# En producción, especificar los dominios exactos: https://midominio.com
CORS_ORIGIN=*

# ================================
# Configuración de Uploads
# ================================
# Directorio donde se almacenan las imágenes subidas
UPLOAD_DIR=./upload/articles
# Tamaño máximo de archivo en bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880
